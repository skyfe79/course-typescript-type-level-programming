{
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "noEmit": true,
    // .ts 확장자를 그대로 적은 import를 허용합니다. node가 타입 스트리핑으로 파일을 그대로
    // 실행하므로, 이 저장소의 상대 import는 확장자를 생략할 수 없습니다.
    "allowImportingTsExtensions": true,
    // 위 옵션은 자바스크립트를 내보내는 프로젝트에서는 단독으로 켤 수 없습니다
    // (error TS5096). 이 옵션이 함께 켜져 있으면 컴파일할 때 상대 import의 .ts가 .js로
    // 바뀌므로, dist를 내보내는 episodes/s16-declaration-files/ts-guards도 그대로 통과합니다.
    "rewriteRelativeImportExtensions": true
  },
  // 일부러 컴파일에 실패시켜 한계를 보여 주는 파일만 여기에서 뺍니다. 저장소 전체 검사
  // (npx tsc --noEmit)를 깨뜨리지 않기 위해서이고, 대신 그 파일 옆의 전용 tsconfig로
  // 따로 검사합니다. 기본값을 덮어쓰는 자리이므로 node_modules를 다시 적어 둡니다.
  "exclude": [
    "node_modules",
    "episodes/s20-why-type-level/instantiation-depth-limit.ts",
    "episodes/s21-conditional-types-infer/recursion-lab.ts",
    "episodes/s29-diagnostics/type-tests-regression.ts",
    // strict 계열 플래그를 단계별로 켜는 실패 실습이므로, 옆의 전용 config들이 대신 검사합니다.
    "episodes/s34-tsconfig-options/strict-demo/src/legacy.ts",
    // 루트 설정에는 이 실습 전용 paths가 없어 @utils 두 import에서 TS2307이 나므로 제외합니다.
    // 대신 paths-demo/tsconfig.json이 nodenext로 두 별칭을 포함한 모든 소스를 따로 검사합니다.
    "episodes/s34-tsconfig-options/paths-demo",
    // 루트 게이트는 noEmit이라 core/dist를 만들지 않고, 새 체크아웃에는 gitignore 대상인 dist가
    // 없어 app이 core/dist/index.d.ts를 찾지 못합니다. 대신 refs-demo/tsconfig.json의
    // npx tsc --build가 두 패키지를 순서대로 모두 검사합니다.
    "episodes/s34-tsconfig-options/refs-demo",
    // 주석 지시어를 일부러 빼 실패시키는 파일이며, 옆의 tsconfig.directive-free.json이 대신 검사합니다.
    "episodes/s35-comment-directives/directive-free.ts",
    // 쓸모없어진 @ts-expect-error가 TS2578을 내는 의도적 실패 실습이므로 루트 검사에서 제외합니다.
    "episodes/s35-comment-directives/suppressed-with-expect-error.ts",
    // 6.0 컴파일러가 자기 tsconfig로 따로 검사하는 별도 설치 뿌리이므로, 7.0 게이트에서
    // 검사하면 이 폴더에만 설치된 @typescript/typescript6 import를 풀지 못해 실패합니다.
    "episodes/s33-release-history/legacy-toolchain"
  ]
}
