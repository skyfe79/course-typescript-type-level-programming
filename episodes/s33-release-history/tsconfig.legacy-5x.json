{
  // TypeScript 5.9 시절 프로젝트가 의존하던 설정을 상속 없이 그대로 재현한다.
  // 현재 컴파일러에서는 제거 진단 다섯 건이 한꺼번에 발생한다.
  "compilerOptions": {
    // TS5108은 옵션 자체가 아니라 특정 값이 제거되었음을 뜻한다.
    // error TS5108: Option 'target=ES5' has been removed. Please remove it from your configuration.
    "target": "es5",
    // commonjs는 현재도 유효하므로 이 값 자체에서는 제거 진단이 발생하지 않는다.
    "module": "commonjs",
    // node는 node10의 옛 별칭이므로 설정에는 node라고 썼어도 진단에는 node10이라고 표시된다.
    // error TS5108: Option 'moduleResolution=node10' has been removed. Please remove it from your configuration.
    "moduleResolution": "node",
    // TS5102는 특정 값이 아니라 옵션 자체가 제거되었음을 뜻한다.
    // baseUrl 진단만 제거 안내 뒤에 paths를 사용하는 대안까지 알려 준다.
    // error TS5102: Option 'baseUrl' has been removed. Please remove it from your configuration.
    //   Use '"paths": {"*": ["./*"]}' instead.
    "baseUrl": ".",
    // error TS5102: Option 'outFile' has been removed. Please remove it from your configuration.
    "outFile": "./dist/bundle.js",
    // error TS5102: Option 'downlevelIteration' has been removed. Please remove it from your configuration.
    "downlevelIteration": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["upgrade-iteration.ts"]
}
