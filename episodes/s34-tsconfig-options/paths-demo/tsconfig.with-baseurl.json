{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // TypeScript 7.0.2에서는 무시되는 옵션이 아니라 제거된 옵션입니다.
    // `npx tsc --noEmit -p tsconfig.with-baseurl.json`은 TS5102를 출력하고,
    // 대안으로 `"paths": {"*": ["./*"]}`를 함께 알려 줍니다.
    //
    // 6.0과 나란히 돌려 보면 제거가 한 번에 일어나지 않았다는 것이 보입니다.
    // 이 저장소에 이미 설치된 6.0.3 컴파일러로 같은 파일을 검사하면 결과가 다릅니다.
    //   6.0.3 → TS5101 사용 중단됨, 7.0에서 기능이 멈출 예정이라는 경고
    //   7.0.2 → TS5102 제거됨
    // 그리고 baseUrl을 적지 않은 옆의 tsconfig.json은 6.0.3에서도 그대로 통과합니다.
    // paths가 이미 6.0부터 baseUrl이 아니라 이 파일이 놓인 폴더를 기준으로 풀리기 때문입니다.
    "baseUrl": "."
  }
}
