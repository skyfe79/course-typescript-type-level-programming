.next
out

# Nuxt.js build / generate output
.nuxt
dist
# 강의 실습용 배포 결과물 (§16 타입 패키지 — ep_114)
# 일반 프로젝트라면 dist는 빌드 결과물이라 커밋하지 않습니다. 다만 이 저장소는 강의 실습용이라,
# ep_114 태그를 체크아웃한 그 상태에서 곧바로 ts-guards-consumer가 돌아야 합니다. dist가 없으면
# 컨슈머의 임포트가 해석되지 않아 저장소 전체 타입 게이트까지 깨지므로 예외를 둡니다.
!episodes/s16-declaration-files/ts-guards/dist/
!episodes/s16-declaration-files/ts-guards/dist/**
# 강의 실습용 배포 결과물 (§17 ledger — ep_124)
# 이 저장소는 강의 실습용이라 ep_124 태그를 체크아웃한 상태에서 곧바로 컨슈머 검증 파일이
# 해석되고 저장소 전체 타입 게이트가 통과해야 합니다. dist가 없으면 ledger 패키지의
# main/types/bin 대상이 비어 있으므로 예외를 둡니다.
!projects/ledger/dist/
!projects/ledger/dist/**
# 강의 실습용 배포 결과물 (§30 imgfx — ep_203)
# 이 저장소는 강의 실습용이라 ep_203 태그를 체크아웃한 상태에서 곧바로 consumer-check.ts가
# 해석되고 저장소 전체 타입 게이트가 통과해야 합니다. dist가 없으면 imgfx 패키지의
# main/types/bin 대상이 비어 있으므로 예외를 둡니다.
!projects/imgfx/dist/
!projects/imgfx/dist/**
# 강의 실습용 배포 결과물 (§31 tinylang — ep_222)
# ep_222 태그를 체크아웃한 상태에서 곧바로 설치된 tinylang 명령어가 돌아야 하므로,
# package.json의 main/types/bin이 가리키는 dist와 그 내용을 강의 자료에 포함합니다.
!projects/tinylang/dist/
!projects/tinylang/dist/**
.output

