{
  // 애플리케이션 config를 거쳐 base의 strict까지 이어지는 3단계 상속을 만듭니다.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // 테스트용 결과물은 별도 폴더에 두기 위해 부모의 "dist"를 "dist-test"로 덮어씁니다.
    "outDir": "dist-test"
    // rootDir는 여기에 적지 않았으므로 부모의 "src"가 그대로 상속됩니다.
    // --showConfig 결과에서 rootDir가 "./src"로 남아 있는 것이 그 증거이고,
    // 이 config로 실제 컴파일을 하면(npx tsc -p tsconfig.test.json) test 폴더의 파일이
    // rootDir 밖에 있다는 TS6059가 납니다. 값을 안 적으면 상속된다는 규칙이
    // outDir뿐 아니라 rootDir에도 똑같이 적용된다는 뜻입니다.
  },
  // 부모의 ["src/**/*.ts"]에 추가되는 것이 아니라, 이 배열로 완전히 대체됩니다.
  // 따라서 --showConfig의 files에는 test 폴더의 파일만 나타납니다.
  "include": ["test/**/*.ts"]
}
