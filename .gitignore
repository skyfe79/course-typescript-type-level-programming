node_modules/
jspm_packages/

# 강의 실습용 모듈 해석 픽스처 (§16 선언 파일 해석 순서 — ep_111)
# 타입스크립트와 node가 위로 올라가며 찾는 폴더 이름이 node_modules여야 하므로 예외를 둡니다.
# git은 무시된 디렉터리 안으로 내려가지 않으므로 폴더와 내용 두 줄이 모두 필요합니다.
!episodes/s16-declaration-files/resolve-demo/node_modules/
!episodes/s16-declaration-files/resolve-demo/node_modules/**

# 강의 실습 산출물 (§17 ledger — 인터프리터가 만드는 저널 파일과 실행 로그)
projects/ledger/journal.json
projects/ledger/run-log.json
# 강의 실습 산출물 (imgfx — PNG 코덱 왕복으로 만드는 복사본)
projects/imgfx/copy.png
# codeStep 455의 CLI가 -o로 만드는 실행 결과물이며 소스가 아닙니다.
projects/imgfx/out.png
# 강의 실습 산출물 (§31 tinylang — build·run이 소스 옆에 만드는 자바스크립트와 복사한 프렐류드)
projects/tinylang/examples/*.js
projects/tinylang/examples/prelude.ts

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

