{
  "compilerOptions": {
    "target": "es2022",
    // package.json의 type: module과 같은 Node.js ESM 규칙으로 두 별칭을 검사합니다.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    // TypeScript 7은 baseUrl 없이 이 tsconfig.json이 있는 폴더를 기준으로 paths 값을 풉니다.
    // nodenext의 ESM 해석에서는 확장자를 자동으로 보충하지 않으므로 실제 .ts까지 적습니다.
    // import 문자열 자체는 .ts로 끝나지 않아 allowImportingTsExtensions는 필요하지 않습니다.
    "paths": {
      "@utils/*": ["./src/utils/*.ts"]
    }
  },
  // 루트 타입 게이트와 분리해도 이 전용 config가 데모의 세 실행 파일을 모두 검사합니다.
  "include": ["src/**/*.ts"]
}
